@model RVS_Aplikacija.ViewModels.UgovorViewModel

@{
    ViewData["Title"] = "Dodaj ugovor";

    Model.StavkeUgovora ??=
        new List<RVS_Aplikacija.ViewModels.StavkaUgovoraViewModel>();

    if (Model.StavkeUgovora.Count == 0)
    {
        Model.StavkeUgovora.Add(
            new RVS_Aplikacija.ViewModels.StavkaUgovoraViewModel()
        );
    }

    Model.DodatneUsluge ??=
        new List<RVS_Aplikacija.ViewModels.DodatnaUslugaUgovoraViewModel>();
}

<h2>Dodaj ugovor</h2>

<hr />

<div class="row">
    <div class="col-xl-10">

        @* Forma grupiše polja koja se šalju kontroleru kada korisnik potvrdi unos. *@
<form asp-action="Dodaj"
              method="post"
              id="ugovor-forma">

            <div asp-validation-summary="All"
                 class="text-danger mb-3">
            </div>

            <h4>Osnovni podaci</h4>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="BrojUgovora"
                           class="form-label">
                    </label>

                    <input asp-for="BrojUgovora"
                           class="form-control"
                           readonly />

                    <div class="form-text">
                        Broj ugovora sistem automatski generiše.
                    </div>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="DatumIzdavanja"
                           class="form-label">
                    </label>

                    <input asp-for="DatumIzdavanja"
                           type="date"
                           class="form-control" />

                    <span asp-validation-for="DatumIzdavanja"
                          class="text-danger">
                    </span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="DatumPreuzimanja"
                           class="form-label">
                    </label>

                    <input asp-for="DatumPreuzimanja"
                           type="datetime-local"
                           class="form-control" />

                    <span asp-validation-for="DatumPreuzimanja"
                          class="text-danger">
                    </span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="DatumVracanja"
                           class="form-label">
                    </label>

                    <input asp-for="DatumVracanja"
                           type="datetime-local"
                           class="form-control" />

                    <span asp-validation-for="DatumVracanja"
                          class="text-danger">
                    </span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="MestoPreuzimanja"
                           class="form-label">
                    </label>

                    <input asp-for="MestoPreuzimanja"
                           class="form-control" />

                    <span asp-validation-for="MestoPreuzimanja"
                          class="text-danger">
                    </span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="MestoVracanja"
                           class="form-label">
                    </label>

                    <input asp-for="MestoVracanja"
                           class="form-control" />

                    <span asp-validation-for="MestoVracanja"
                          class="text-danger">
                    </span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="KlijentId"
                           class="form-label">
                    </label>

                    <select asp-for="KlijentId"
                            asp-items="Model.KlijentiOpcije"
                            class="form-select">
                        <option value="">Izaberite klijenta</option>
                    </select>

                    <span asp-validation-for="KlijentId"
                          class="text-danger">
                    </span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="KorisnikId"
                           class="form-label">
                    </label>

                    <select asp-for="KorisnikId"
                            asp-items="Model.KorisniciOpcije"
                            class="form-select">
                        <option value="">Izaberite korisnika</option>
                    </select>

                    <span asp-validation-for="KorisnikId"
                          class="text-danger">
                    </span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-4 mb-3">
                    <label asp-for="NacinPlacanja"
                           class="form-label">
                    </label>

                    <select asp-for="NacinPlacanja"
                            class="form-select">
                        <option value="">Izaberite način plaćanja</option>
                        <option value="Gotovina">Gotovina</option>
                        <option value="Kartica">Kartica</option>
                        <option value="Uplata na račun">Uplata na račun</option>
                    </select>

                    <span asp-validation-for="NacinPlacanja"
                          class="text-danger">
                    </span>
                </div>

                <div class="col-md-4 mb-3">
                    <label asp-for="Depozit"
                           class="form-label">
                    </label>

                    <input asp-for="Depozit"
                           type="number"
                           step="0.01"
                           min="0"
                           class="form-control" />

                    <span asp-validation-for="Depozit"
                          class="text-danger">
                    </span>
                </div>

                <div class="col-md-4 mb-3">
                    <label asp-for="PopustProcenat"
                           class="form-label">
                    </label>

                    <input asp-for="PopustProcenat"
                           type="number"
                           step="0.01"
                           min="0"
                           max="100"
                           class="form-control"
                           readonly />

                    <div class="form-text">
                        Za iznajmljivanje od 7 ili više dana automatski se odobrava 10% popusta.
                    </div>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Napomena"
                       class="form-label">
                </label>

                <textarea asp-for="Napomena"
                          class="form-control"
                          rows="3"></textarea>

                <span asp-validation-for="Napomena"
                      class="text-danger">
                </span>
            </div>

            <input asp-for="StatusUgovora"
                   type="hidden" />

            <input asp-for="UkupnoZaPlacanje"
                   type="hidden" />

            <hr />

            <div class="d-flex justify-content-between align-items-center gap-3 mb-3">
                <div>
                    <h4 class="mb-1">Vozila</h4>

                    <div class="text-muted small">
                        Jedan ugovor može sadržati više različitih vozila.
                    </div>
                </div>

                <button type="button"
                        id="dodaj-vozilo"
                        class="btn btn-primary">
                    Dodaj još jedno vozilo
                </button>
            </div>

            <div asp-validation-for="StavkeUgovora"
                 class="text-danger mb-2">
            </div>

            <div id="vozila-container">
                @for (int i = 0;
                     i < Model.StavkeUgovora.Count;
                     i++)
                {
                    <div class="card mb-3 vozilo-red"
                         data-index="@i">

                        <div class="card-header d-flex justify-content-between align-items-center">
                            <strong class="vozilo-naslov">
                                Vozilo @(i + 1)
                            </strong>

                            <button type="button"
                                    class="btn btn-sm btn-outline-danger ukloni-vozilo">
                                Ukloni
                            </button>
                        </div>

                        <div class="card-body">
                            <input asp-for="StavkeUgovora[i].BrojDana"
                                   type="hidden"
                                   class="vozilo-broj-dana" />

                            <input asp-for="StavkeUgovora[i].Ukupno"
                                   type="hidden"
                                   class="vozilo-ukupno-hidden" />

                            <div class="row">
                                <div class="col-lg-5 mb-3">
                                    <label asp-for="StavkeUgovora[i].VoziloId"
                                           class="form-label">
                                        Vozilo
                                    </label>

                                    <select asp-for="StavkeUgovora[i].VoziloId"
                                            asp-items="Model.VozilaOpcije"
                                            class="form-select izbor-vozila">
                                        <option value="">Izaberite vozilo</option>
                                    </select>

                                    <span asp-validation-for="StavkeUgovora[i].VoziloId"
                                          class="text-danger vozilo-validacija">
                                    </span>
                                </div>

                                <div class="col-lg-3 mb-3">
                                    <label asp-for="StavkeUgovora[i].CenaPoDanu"
                                           class="form-label">
                                        Cena po danu
                                    </label>

                                    <input asp-for="StavkeUgovora[i].CenaPoDanu"
                                           type="number"
                                           step="0.01"
                                           min="0.01"
                                           class="form-control cena-vozila"
                                           readonly />

                                    <span asp-validation-for="StavkeUgovora[i].CenaPoDanu"
                                          class="text-danger cena-validacija">
                                    </span>
                                </div>

                                <div class="col-lg-2 mb-3">
                                    <label asp-for="StavkeUgovora[i].PopustProcenat"
                                           class="form-label">
                                        Popust vozila
                                    </label>

                                    <input asp-for="StavkeUgovora[i].PopustProcenat"
                                           type="number"
                                           step="0.01"
                                           min="0"
                                           max="100"
                                           class="form-control popust-vozila" />
                                </div>

                                <div class="col-lg-2 mb-3">
                                    <label class="form-label">
                                        Ukupno
                                    </label>

                                    <input type="text"
                                           class="form-control vozilo-ukupno-prikaz"
                                           value="0.00"
                                           readonly />
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <div id="duplikat-vozila-upozorenje"
                 class="alert alert-danger d-none">
                Isto vozilo ne može biti izabrano više puta.
            </div>

            <div class="text-end mb-3">
                <strong>
                    Ukupno sva vozila:
                    <span id="ukupno-vozila-prikaz">0.00</span> RSD
                </strong>
            </div>

            <template id="vozilo-template">
                <div class="card mb-3 vozilo-red"
                     data-index="__INDEX__">

                    <div class="card-header d-flex justify-content-between align-items-center">
                        <strong class="vozilo-naslov">
                            Vozilo
                        </strong>

                        <button type="button"
                                class="btn btn-sm btn-outline-danger ukloni-vozilo">
                            Ukloni
                        </button>
                    </div>

                    <div class="card-body">
                        <input name="StavkeUgovora[__INDEX__].BrojDana"
                               id="StavkeUgovora___INDEX____BrojDana"
                               type="hidden"
                               class="vozilo-broj-dana"
                               value="1" />

                        <input name="StavkeUgovora[__INDEX__].Ukupno"
                               id="StavkeUgovora___INDEX____Ukupno"
                               type="hidden"
                               class="vozilo-ukupno-hidden"
                               value="0" />

                        <div class="row">
                            <div class="col-lg-5 mb-3">
                                <label class="form-label"
                                       for="StavkeUgovora___INDEX____VoziloId">
                                    Vozilo
                                </label>

                                <select name="StavkeUgovora[__INDEX__].VoziloId"
                                        id="StavkeUgovora___INDEX____VoziloId"
                                        class="form-select izbor-vozila">
                                    <option value="">Izaberite vozilo</option>

                                    @foreach (var opcija in Model.VozilaOpcije)
                                    {
                                        <option value="@opcija.Value">
                                            @opcija.Text
                                        </option>
                                    }
                                </select>

                                <span class="text-danger vozilo-validacija"
                                      data-valmsg-for="StavkeUgovora[__INDEX__].VoziloId"
                                      data-valmsg-replace="true">
                                </span>
                            </div>

                            <div class="col-lg-3 mb-3">
                                <label class="form-label"
                                       for="StavkeUgovora___INDEX____CenaPoDanu">
                                    Cena po danu
                                </label>

                                <input name="StavkeUgovora[__INDEX__].CenaPoDanu"
                                       id="StavkeUgovora___INDEX____CenaPoDanu"
                                       type="number"
                                       step="0.01"
                                       min="0.01"
                                       class="form-control cena-vozila"
                                       readonly />

                                <span class="text-danger cena-validacija"
                                      data-valmsg-for="StavkeUgovora[__INDEX__].CenaPoDanu"
                                      data-valmsg-replace="true">
                                </span>
                            </div>

                            <div class="col-lg-2 mb-3">
                                <label class="form-label"
                                       for="StavkeUgovora___INDEX____PopustProcenat">
                                    Popust vozila
                                </label>

                                <input name="StavkeUgovora[__INDEX__].PopustProcenat"
                                       id="StavkeUgovora___INDEX____PopustProcenat"
                                       type="number"
                                       step="0.01"
                                       min="0"
                                       max="100"
                                       value="0"
                                       class="form-control popust-vozila" />
                            </div>

                            <div class="col-lg-2 mb-3">
                                <label class="form-label">
                                    Ukupno
                                </label>

                                <input type="text"
                                       class="form-control vozilo-ukupno-prikaz"
                                       value="0.00"
                                       readonly />
                            </div>
                        </div>
                    </div>
                </div>
            </template>

            <hr />

            <h4>Dodatne usluge</h4>

            <div class="card mb-3">
                <div class="card-body">
                    @for (int i = 0;
                         i < Model.DodatneUsluge.Count;
                         i++)
                    {
                        <div class="row align-items-center border-bottom py-2 dodatna-usluga-red">

                            <input asp-for="DodatneUsluge[i].DodatnaUslugaId"
                                   type="hidden" />

                            <input asp-for="DodatneUsluge[i].NazivUsluge"
                                   type="hidden" />

                            <input asp-for="DodatneUsluge[i].Ukupno"
                                   type="hidden"
                                   class="usluga-ukupno-hidden" />

                            <div class="col-md-4">
                                <div class="form-check">
                                    <input asp-for="DodatneUsluge[i].Izabrana"
                                           class="form-check-input usluga-checkbox" />

                                    <label asp-for="DodatneUsluge[i].Izabrana"
                                           class="form-check-label">
                                        @Model.DodatneUsluge[i].NazivUsluge
                                    </label>
                                </div>
                            </div>

                            <div class="col-md-3">
                                <label class="form-label">
                                    Cena po danu
                                </label>

                                <input asp-for="DodatneUsluge[i].CenaPoDanu"
                                       type="number"
                                       step="0.01"
                                       min="0"
                                       class="form-control usluga-cena" />
                            </div>

                            <div class="col-md-2">
                                <label class="form-label">
                                    Broj dana
                                </label>

                                <input asp-for="DodatneUsluge[i].BrojDana"
                                       type="number"
                                       min="1"
                                       class="form-control usluga-dani"
                                       readonly />
                            </div>

                            <div class="col-md-3">
                                <label class="form-label">
                                    Ukupno
                                </label>

                                <input type="text"
                                       class="form-control usluga-ukupno-prikaz"
                                       value="0.00"
                                       readonly />
                            </div>
                        </div>
                    }

                    <div class="text-end mt-3">
                        <strong>
                            Ukupno dodatne usluge:
                            <span id="ukupno-dodatne-usluge">0.00</span> RSD
                        </strong>
                    </div>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header">
                    <strong>Obračun ugovora</strong>
                </div>

                <div class="card-body">
                    <div class="row g-2">
                        <div class="col-md-6">
                            <div class="d-flex justify-content-between">
                                <span>Broj dana:</span>
                                <strong id="broj-dana-prikaz">1</strong>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="d-flex justify-content-between">
                                <span>Ukupno sva vozila:</span>
                                <strong>
                                    <span id="ukupno-vozila-obracun">0.00</span> RSD
                                </strong>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="d-flex justify-content-between">
                                <span>Dodatne usluge:</span>
                                <strong>
                                    <span id="ukupno-dodatne-usluge-obracun">0.00</span> RSD
                                </strong>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="d-flex justify-content-between">
                                <span>Automatski popust:</span>
                                <strong>
                                    <span id="popust-procenat-prikaz">0.00</span> %
                                </strong>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="d-flex justify-content-between">
                                <span>Iznos popusta:</span>
                                <strong>
                                    <span id="iznos-popusta-prikaz">0.00</span> RSD
                                </strong>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="d-flex justify-content-between">
                                <span>Uplaćen depozit:</span>
                                <strong>
                                    <span id="depozit-prikaz">0.00</span> RSD
                                </strong>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="d-flex justify-content-between">
                                <span>Ukupno pre depozita:</span>
                                <strong>
                                    <span id="ukupno-pre-depozita-prikaz">0.00</span> RSD
                                </strong>
                            </div>
                        </div>
                    </div>

                    <hr />

                    <div class="d-flex justify-content-between align-items-center">
                        <span class="h5 mb-0">
                            Preostalo za plaćanje:
                        </span>

                        <strong class="h4 text-success mb-0">
                            <span id="ukupno-za-placanje-prikaz">0.00</span> RSD
                        </strong>
                    </div>

                    <div id="depozit-upozorenje"
                         class="text-danger small mt-2 d-none">
                        Depozit ne može biti veći od ukupne vrednosti ugovora.
                    </div>
                </div>
            </div>

            <button type="submit"
                    id="sacuvaj-ugovor"
                    class="btn btn-success">
                Sačuvaj ugovor
            </button>

            <a asp-action="Index"
               class="btn btn-secondary">
                Nazad
            </a>
        </form>
    </div>
</div>

@* Scripts sekcija se renderuje na dnu layout-a; ovde su validacija i dinamičko ponašanje forme. *@
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const forma =
                document.getElementById("ugovor-forma");

            const vozilaContainer =
                document.getElementById("vozila-container");

            const voziloTemplate =
                document.getElementById("vozilo-template");

            const dodajVoziloDugme =
                document.getElementById("dodaj-vozilo");

            const datumPreuzimanja =
                document.getElementById("DatumPreuzimanja");

            const datumVracanja =
                document.getElementById("DatumVracanja");

            const depozitInput =
                document.getElementById("Depozit");

            const popustUgovoraInput =
                document.getElementById("PopustProcenat");

            const ukupnoZaPlacanjeInput =
                document.getElementById("UkupnoZaPlacanje");

            const dugmeSacuvaj =
                document.getElementById("sacuvaj-ugovor");

            function procitajBroj(vrednost) {
                if (vrednost === null ||
                    vrednost === undefined ||
                    vrednost === "") {
                    return 0;
                }

                return Number.parseFloat(
                    vrednost
                        .toString()
                        .replace(/\s/g, "")
                        .replace(",", ".")
                ) || 0;
            }

            function formatirajNovac(iznos) {
                return Number(iznos || 0)
                    .toLocaleString(
                        "sr-RS",
                        {
                            minimumFractionDigits: 2,
                            maximumFractionDigits: 2
                        }
                    );
            }

            function postaviTekst(id, vrednost) {
                const element =
                    document.getElementById(id);

                if (element) {
                    element.textContent = vrednost;
                }
            }

            function izracunajBrojDana() {
                if (!datumPreuzimanja ||
                    !datumVracanja ||
                    !datumPreuzimanja.value ||
                    !datumVracanja.value) {
                    return 1;
                }

                const preuzimanje =
                    new Date(datumPreuzimanja.value);

                const vracanje =
                    new Date(datumVracanja.value);

                if (Number.isNaN(preuzimanje.getTime()) ||
                    Number.isNaN(vracanje.getTime())) {
                    return 1;
                }

                const razlika =
                    vracanje.getTime() -
                    preuzimanje.getTime();

                return Math.max(
                    1,
                    Math.ceil(
                        razlika /
                        (1000 * 60 * 60 * 24)
                    )
                );
            }

            function redoviVozila() {
                return Array.from(
                    vozilaContainer.querySelectorAll(
                        ".vozilo-red"
                    )
                );
            }

            function reindeksirajVozila() {
                redoviVozila().forEach(
                    function (red, index) {
                        red.dataset.index = index;

                        const naslov =
                            red.querySelector(
                                ".vozilo-naslov"
                            );

                        if (naslov) {
                            naslov.textContent =
                                `Vozilo ${index + 1}`;
                        }

                        red.querySelectorAll(
                            "[name]"
                        ).forEach(function (element) {
                            element.name =
                                element.name.replace(
                                    /StavkeUgovora\[\d+\]/g,
                                    `StavkeUgovora[${index}]`
                                );
                        });

                        red.querySelectorAll(
                            "[id]"
                        ).forEach(function (element) {
                            element.id =
                                element.id.replace(
                                    /StavkeUgovora_\d+__/g,
                                    `StavkeUgovora_${index}__`
                                );
                        });

                        red.querySelectorAll(
                            "label[for]"
                        ).forEach(function (labela) {
                            labela.htmlFor =
                                labela.htmlFor.replace(
                                    /StavkeUgovora_\d+__/g,
                                    `StavkeUgovora_${index}__`
                                );
                        });

                        red.querySelectorAll(
                            "[data-valmsg-for]"
                        ).forEach(function (element) {
                            element.setAttribute(
                                "data-valmsg-for",
                                element
                                    .getAttribute(
                                        "data-valmsg-for"
                                    )
                                    .replace(
                                        /StavkeUgovora\[\d+\]/g,
                                        `StavkeUgovora[${index}]`
                                    )
                            );
                        });
                    }
                );
            }

            function osveziDugmadZaUklanjanje() {
                const redovi =
                    redoviVozila();

                redovi.forEach(function (red) {
                    const dugme =
                        red.querySelector(
                            ".ukloni-vozilo"
                        );

                    if (dugme) {
                        dugme.disabled =
                            redovi.length <= 1;
                    }
                });
            }

            function proveriDuplikateVozila() {
                const izabraniIdjevi =
                    redoviVozila()
                        .map(red =>
                            red.querySelector(
                                ".izbor-vozila"
                            )?.value
                        )
                        .filter(vrednost =>
                            vrednost &&
                            Number(vrednost) > 0
                        );

                const jedinstveni =
                    new Set(izabraniIdjevi);

                const imaDuplikata =
                    jedinstveni.size !==
                    izabraniIdjevi.length;

                const upozorenje =
                    document.getElementById(
                        "duplikat-vozila-upozorenje"
                    );

                if (upozorenje) {
                    upozorenje.classList.toggle(
                        "d-none",
                        !imaDuplikata
                    );
                }

                return imaDuplikata;
            }

            function osveziDostupneOpcije() {
                const selectPolja =
                    redoviVozila()
                        .map(red =>
                            red.querySelector(
                                ".izbor-vozila"
                            )
                        )
                        .filter(Boolean);

                const izabraneVrednosti =
                    selectPolja
                        .map(select => select.value)
                        .filter(Boolean);

                selectPolja.forEach(function (select) {
                    Array.from(select.options)
                        .forEach(function (opcija) {
                            if (!opcija.value) {
                                opcija.disabled = false;
                                return;
                            }

                            opcija.disabled =
                                izabraneVrednosti
                                    .includes(opcija.value) &&
                                select.value !==
                                    opcija.value;
                        });
                });
            }

            async function ucitajCenuVozila(red) {
                const select =
                    red.querySelector(
                        ".izbor-vozila"
                    );

                const cenaInput =
                    red.querySelector(
                        ".cena-vozila"
                    );

                if (!select || !cenaInput) {
                    return;
                }

                const voziloId = select.value;

                if (!voziloId ||
                    Number(voziloId) <= 0) {
                    cenaInput.value = "";
                    izracunajSve();
                    return;
                }

                cenaInput.value = "";
                cenaInput.placeholder =
                    "Učitavanje...";

                try {
                    const odgovor =
                        await fetch(
                            `/Ugovori/PreuzmiCenuVozila?id=${encodeURIComponent(voziloId)}`,
                            {
                                method: "GET",
                                headers: {
                                    "Accept":
                                        "application/json"
                                }
                            }
                        );

                    if (!odgovor.ok) {
                        const tekst =
                            await odgovor.text();

                        throw new Error(
                            `Greška ${odgovor.status}: ${tekst}`
                        );
                    }

                    const rezultat =
                        await odgovor.json();

                    const cena =
                        Number(
                            rezultat.cenaPoDanu
                        );

                    if (Number.isNaN(cena) ||
                        cena <= 0) {
                        throw new Error(
                            "API je vratio neispravnu cenu vozila."
                        );
                    }

                    cenaInput.value =
                        cena.toFixed(2);
                }
                catch (greska) {
                    cenaInput.value = "";

                    console.error(
                        "Cena vozila nije učitana:",
                        greska
                    );
                }
                finally {
                    cenaInput.placeholder = "";
                    izracunajSve();
                }
            }

            function izracunajVozila(brojDana) {
                let ukupnoSvaVozila = 0;

                redoviVozila().forEach(function (red) {
                    const cena =
                        procitajBroj(
                            red.querySelector(
                                ".cena-vozila"
                            )?.value
                        );

                    const popust =
                        Math.min(
                            100,
                            Math.max(
                                0,
                                procitajBroj(
                                    red.querySelector(
                                        ".popust-vozila"
                                    )?.value
                                )
                            )
                        );

                    const osnovica =
                        cena * brojDana;

                    const ukupno =
                        Math.max(
                            0,
                            osnovica -
                            osnovica *
                            popust /
                            100
                        );

                    const brojDanaInput =
                        red.querySelector(
                            ".vozilo-broj-dana"
                        );

                    const ukupnoHidden =
                        red.querySelector(
                            ".vozilo-ukupno-hidden"
                        );

                    const ukupnoPrikaz =
                        red.querySelector(
                            ".vozilo-ukupno-prikaz"
                        );

                    if (brojDanaInput) {
                        brojDanaInput.value =
                            brojDana;
                    }

                    if (ukupnoHidden) {
                        ukupnoHidden.value =
                            ukupno.toFixed(2);
                    }

                    if (ukupnoPrikaz) {
                        ukupnoPrikaz.value =
                            ukupno.toFixed(2);
                    }

                    ukupnoSvaVozila += ukupno;
                });

                postaviTekst(
                    "ukupno-vozila-prikaz",
                    formatirajNovac(
                        ukupnoSvaVozila
                    )
                );

                return ukupnoSvaVozila;
            }

            function izracunajDodatneUsluge(brojDana) {
                let ukupnoSve = 0;

                document
                    .querySelectorAll(
                        ".dodatna-usluga-red"
                    )
                    .forEach(function (red) {
                        const checkbox =
                            red.querySelector(
                                ".usluga-checkbox"
                            );

                        const cenaInput =
                            red.querySelector(
                                ".usluga-cena"
                            );

                        const daniInput =
                            red.querySelector(
                                ".usluga-dani"
                            );

                        const ukupnoPrikaz =
                            red.querySelector(
                                ".usluga-ukupno-prikaz"
                            );

                        const ukupnoHidden =
                            red.querySelector(
                                ".usluga-ukupno-hidden"
                            );

                        if (!checkbox ||
                            !cenaInput ||
                            !daniInput) {
                            return;
                        }

                        daniInput.value =
                            brojDana;

                        const cena =
                            procitajBroj(
                                cenaInput.value
                            );

                        const ukupno =
                            checkbox.checked
                                ? cena * brojDana
                                : 0;

                        if (ukupnoPrikaz) {
                            ukupnoPrikaz.value =
                                ukupno.toFixed(2);
                        }

                        if (ukupnoHidden) {
                            ukupnoHidden.value =
                                ukupno.toFixed(2);
                        }

                        cenaInput.disabled =
                            !checkbox.checked;

                        ukupnoSve += ukupno;
                    });

                postaviTekst(
                    "ukupno-dodatne-usluge",
                    formatirajNovac(ukupnoSve)
                );

                return ukupnoSve;
            }

            function izracunajSve() {
                const brojDana =
                    izracunajBrojDana();

                const automatskiPopust =
                    brojDana >= 7
                        ? 10
                        : 0;

                if (popustUgovoraInput) {
                    popustUgovoraInput.value =
                        automatskiPopust.toFixed(2);
                }

                const ukupnoVozila =
                    izracunajVozila(
                        brojDana
                    );

                const ukupnoDodatneUsluge =
                    izracunajDodatneUsluge(
                        brojDana
                    );

                const iznosPopusta =
                    ukupnoVozila *
                    automatskiPopust /
                    100;

                const ukupnoPreDepozita =
                    Math.max(
                        0,
                        ukupnoVozila +
                        ukupnoDodatneUsluge -
                        iznosPopusta
                    );

                const depozit =
                    Math.max(
                        0,
                        procitajBroj(
                            depozitInput?.value
                        )
                    );

                const depozitPrevelik =
                    depozit >
                    ukupnoPreDepozita;

                const imaDuplikata =
                    proveriDuplikateVozila();

                const preostaloZaPlacanje =
                    Math.max(
                        0,
                        ukupnoPreDepozita -
                        depozit
                    );

                if (ukupnoZaPlacanjeInput) {
                    ukupnoZaPlacanjeInput.value =
                        preostaloZaPlacanje
                            .toFixed(2);
                }

                postaviTekst(
                    "broj-dana-prikaz",
                    brojDana.toString()
                );

                postaviTekst(
                    "ukupno-vozila-obracun",
                    formatirajNovac(
                        ukupnoVozila
                    )
                );

                postaviTekst(
                    "ukupno-dodatne-usluge-obracun",
                    formatirajNovac(
                        ukupnoDodatneUsluge
                    )
                );

                postaviTekst(
                    "popust-procenat-prikaz",
                    automatskiPopust
                        .toFixed(2)
                );

                postaviTekst(
                    "iznos-popusta-prikaz",
                    formatirajNovac(
                        iznosPopusta
                    )
                );

                postaviTekst(
                    "depozit-prikaz",
                    formatirajNovac(depozit)
                );

                postaviTekst(
                    "ukupno-pre-depozita-prikaz",
                    formatirajNovac(
                        ukupnoPreDepozita
                    )
                );

                postaviTekst(
                    "ukupno-za-placanje-prikaz",
                    formatirajNovac(
                        preostaloZaPlacanje
                    )
                );

                const depozitUpozorenje =
                    document.getElementById(
                        "depozit-upozorenje"
                    );

                if (depozitUpozorenje) {
                    depozitUpozorenje
                        .classList
                        .toggle(
                            "d-none",
                            !depozitPrevelik
                        );
                }

                if (depozitInput) {
                    depozitInput.classList.toggle(
                        "is-invalid",
                        depozitPrevelik
                    );
                }

                if (dugmeSacuvaj) {
                    dugmeSacuvaj.disabled =
                        depozitPrevelik ||
                        imaDuplikata;
                }
            }

            function poveziRedVozila(red) {
                const select =
                    red.querySelector(
                        ".izbor-vozila"
                    );

                const popust =
                    red.querySelector(
                        ".popust-vozila"
                    );

                const ukloniDugme =
                    red.querySelector(
                        ".ukloni-vozilo"
                    );

                if (select) {
                    select.addEventListener(
                        "change",
                        async function () {
                            osveziDostupneOpcije();
                            await ucitajCenuVozila(red);
                        }
                    );
                }

                if (popust) {
                    popust.addEventListener(
                        "input",
                        izracunajSve
                    );

                    popust.addEventListener(
                        "change",
                        izracunajSve
                    );
                }

                if (ukloniDugme) {
                    ukloniDugme.addEventListener(
                        "click",
                        function () {
                            if (redoviVozila().length <= 1) {
                                return;
                            }

                            red.remove();
                            reindeksirajVozila();
                            osveziDugmadZaUklanjanje();
                            osveziDostupneOpcije();
                            izracunajSve();
                        }
                    );
                }
            }

            dodajVoziloDugme.addEventListener(
                "click",
                function () {
                    const indeks =
                        redoviVozila().length;

                    const html =
                        voziloTemplate.innerHTML
                            .replaceAll(
                                "__INDEX__",
                                indeks.toString()
                            );

                    vozilaContainer
                        .insertAdjacentHTML(
                            "beforeend",
                            html
                        );

                    const noviRed =
                        redoviVozila().at(-1);

                    poveziRedVozila(noviRed);
                    reindeksirajVozila();
                    osveziDugmadZaUklanjanje();
                    osveziDostupneOpcije();
                    izracunajSve();

                    if (window.jQuery &&
                        window.jQuery.validator &&
                        window.jQuery.validator.unobtrusive) {
                        window.jQuery.validator
                            .unobtrusive
                            .parse(forma);
                    }
                }
            );

            redoviVozila().forEach(
                function (red) {
                    poveziRedVozila(red);
                }
            );

            document
                .querySelectorAll(
                    ".usluga-checkbox, .usluga-cena"
                )
                .forEach(function (element) {
                    element.addEventListener(
                        "change",
                        izracunajSve
                    );

                    element.addEventListener(
                        "input",
                        izracunajSve
                    );
                });

            [
                datumPreuzimanja,
                datumVracanja,
                depozitInput
            ]
                .filter(Boolean)
                .forEach(function (element) {
                    element.addEventListener(
                        "change",
                        izracunajSve
                    );

                    element.addEventListener(
                        "input",
                        izracunajSve
                    );
                });

            forma.addEventListener(
                "submit",
                function (dogadjaj) {
                    reindeksirajVozila();

                    if (proveriDuplikateVozila()) {
                        dogadjaj.preventDefault();
                    }
                }
            );

            osveziDugmadZaUklanjanje();
            osveziDostupneOpcije();

            const ucitavanjaCena =
                redoviVozila()
                    .filter(red =>
                        red.querySelector(
                            ".izbor-vozila"
                        )?.value
                    )
                    .map(red =>
                        ucitajCenuVozila(red)
                    );

            if (ucitavanjaCena.length > 0) {
                Promise.all(ucitavanjaCena)
                    .finally(izracunajSve);
            }
            else {
                izracunajSve();
            }
        });
    </script>
}
