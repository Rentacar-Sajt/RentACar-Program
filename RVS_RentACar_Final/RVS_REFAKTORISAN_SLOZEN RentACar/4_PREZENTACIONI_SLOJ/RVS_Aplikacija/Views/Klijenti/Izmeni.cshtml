@model RVS_Aplikacija.ViewModels.KlijentViewModel

@{
    ViewData["Title"] = "Izmena klijenta";
}

<h2>Izmena klijenta</h2>

<hr />

<div class="row">
    <div class="col-md-8">
        @* Forma grupiše polja koja se šalju kontroleru kada korisnik potvrdi unos. *@
<form asp-action="Izmeni" method="post">

            <input asp-for="Id" type="hidden" />

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Ime" class="form-label"></label>
                <input asp-for="Ime" class="form-control" />
                <span asp-validation-for="Ime" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Prezime" class="form-label"></label>
                <input asp-for="Prezime" class="form-control" />
                <span asp-validation-for="Prezime" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="JMBG" class="form-label"></label>
                <input asp-for="JMBG" class="form-control" />
                <span asp-validation-for="JMBG" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="BrojPasosa" class="form-label"></label>
                <input asp-for="BrojPasosa" class="form-control" />
                <span asp-validation-for="BrojPasosa" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="BrojVozackeDozvole" class="form-label"></label>
                <input asp-for="BrojVozackeDozvole" class="form-control" />
                <span asp-validation-for="BrojVozackeDozvole" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="DatumIzdavanjaDozvole" class="form-label"></label>
                <input asp-for="DatumIzdavanjaDozvole" type="date" class="form-control" />
                <span asp-validation-for="DatumIzdavanjaDozvole" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="DatumIstekaVozackeDozvole" class="form-label"></label>
                <input asp-for="DatumIstekaVozackeDozvole" type="date" class="form-control" />
                <span asp-validation-for="DatumIstekaVozackeDozvole" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Telefon" class="form-label"></label>
                <input asp-for="Telefon" class="form-control" />
                <span asp-validation-for="Telefon" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Adresa" class="form-label"></label>
                <input asp-for="Adresa" class="form-control" />
                <span asp-validation-for="Adresa" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-warning">
                Sačuvaj izmene
            </button>

            <a asp-action="Index" class="btn btn-secondary">
                Odustani
            </a>

        </form>
    </div>
</div>

@* Scripts sekcija se renderuje na dnu layout-a; ovde su validacija i dinamičko ponašanje forme. *@
@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}