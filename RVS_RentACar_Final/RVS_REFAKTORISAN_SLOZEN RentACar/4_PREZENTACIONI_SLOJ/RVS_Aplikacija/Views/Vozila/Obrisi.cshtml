@model RVS_Aplikacija.ViewModels.VoziloViewModel

@{
    ViewData["Title"] = "Obriši vozilo";
}

<h1>Obriši vozilo</h1>

<hr />

@if (TempData["Greska"] != null)
{
    <div class="alert alert-danger">
        @TempData["Greska"]
    </div>
}

<div class="alert alert-warning">
    Da li ste sigurni da želite da obrišete ovo vozilo?
</div>

<div class="card">
    <div class="card-body">

        <dl class="row">

            <dt class="col-sm-3">
                ID
            </dt>
            <dd class="col-sm-9">
                @Model.Id
            </dd>

            <dt class="col-sm-3">
                Marka
            </dt>
            <dd class="col-sm-9">
                @Model.Marka
            </dd>

            <dt class="col-sm-3">
                Model
            </dt>
            <dd class="col-sm-9">
                @Model.Model
            </dd>

            <dt class="col-sm-3">
                Registracija
            </dt>
            <dd class="col-sm-9">
                @Model.Registracija
            </dd>

            <dt class="col-sm-3">
                Cena po danu
            </dt>
            <dd class="col-sm-9">
                @Model.CenaPoDanu.ToString("N2") RSD
            </dd>

            <dt class="col-sm-3">
                Status vozila
            </dt>
            <dd class="col-sm-9">
                @Model.StatusVozila
            </dd>

        </dl>

        @* Forma grupiše polja koja se šalju kontroleru kada korisnik potvrdi unos. *@
<form asp-controller="Vozila"
              asp-action="ObrisiPotvrda"
              asp-route-id="@Model.Id"
              method="post">

            @Html.AntiForgeryToken()

            <button type="submit"
                    class="btn btn-danger">
                Obriši
            </button>

            <a asp-controller="Vozila"
               asp-action="Index"
               class="btn btn-secondary">
                Odustani
            </a>

        </form>

    </div>
</div>