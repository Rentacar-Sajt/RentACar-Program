@model RVS_Aplikacija.ViewModels.VoziloViewModel

@{
    ViewData["Title"] = "Detalji vozila";
}

<h1>Detalji vozila</h1>

<hr />

<div class="card">
    <div class="card-body">

        <dl class="row">

            <dt class="col-sm-3">
                ID
            </dt>
            <dd class="col-sm-9">
                @Model.Id
            </dd>

            <dt class="col-sm-3">
                Marka
            </dt>
            <dd class="col-sm-9">
                @Model.Marka
            </dd>

            <dt class="col-sm-3">
                Model
            </dt>
            <dd class="col-sm-9">
                @Model.Model
            </dd>

            <dt class="col-sm-3">
                Registracija
            </dt>
            <dd class="col-sm-9">
                @Model.Registracija
            </dd>

            <dt class="col-sm-3">
                Cena po danu
            </dt>
            <dd class="col-sm-9">
                @Model.CenaPoDanu
            </dd>

            <dt class="col-sm-3">
                Status vozila
            </dt>
            <dd class="col-sm-9">
                @Model.StatusVozila
            </dd>

        </dl>

        <a asp-controller="Vozila"
           asp-action="Index"
           class="btn btn-secondary">
            Nazad
        </a>

    </div>
</div>