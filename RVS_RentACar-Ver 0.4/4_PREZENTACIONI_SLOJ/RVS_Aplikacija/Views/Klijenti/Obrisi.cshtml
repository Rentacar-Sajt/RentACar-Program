@model RVS_Aplikacija.ViewModels.KlijentViewModel

@{
    ViewData["Title"] = "Brisanje klijenta";
}

<h2>Brisanje klijenta</h2>

<div class="alert alert-warning">
    Da li ste sigurni da želite da obrišete ovog klijenta?
</div>

<div class="card">
    <div class="card-body">

        <dl class="row">

            <dt class="col-sm-4">Ime i prezime</dt>
            <dd class="col-sm-8">
                @Model.Ime @Model.Prezime
            </dd>

            <dt class="col-sm-4">Email</dt>
            <dd class="col-sm-8">
                @Model.Email
            </dd>

            <dt class="col-sm-4">JMBG</dt>
            <dd class="col-sm-8">
                @Model.JMBG
            </dd>

            <dt class="col-sm-4">Broj vozačke dozvole</dt>
            <dd class="col-sm-8">
                @Model.BrojVozackeDozvole
            </dd>

            <dt class="col-sm-4">Telefon</dt>
            <dd class="col-sm-8">
                @Model.Telefon
            </dd>

            <dt class="col-sm-4">Adresa</dt>
            <dd class="col-sm-8">
                @Model.Adresa
            </dd>

        </dl>

        <form asp-action="ObrisiPotvrda"
              asp-route-id="@Model.Id"
              method="post">

            <button type="submit" class="btn btn-danger">
                Potvrdi brisanje
            </button>

            <a asp-action="Index" class="btn btn-secondary">
                Odustani
            </a>

        </form>

    </div>
</div>