@using Microsoft.AspNetCore.Http
@{
    // Dohvata se iz sesije, sa fallback vrednostima
    var korisnikUloga = Context.Session.GetString("KorisnikUloga") ?? "Nema uloge";
}
<!DOCTYPE html>
<html lang="sr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Веб Курсеви</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Pocetna" asp-action="Index">Веб Курсеви</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Промени навигацију">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Pocetna" asp-action="Index">Почетна</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Kursevi" asp-action="Index">Курсеви</a>
                        </li>
                        @if (User.Identity?.IsAuthenticated ?? false)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Tehnologije" asp-action="Index">Технологије</a>
                            </li>

                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="apiDropdown" role="button"
                                   data-bs-toggle="dropdown" aria-expanded="false">
                                    API (Технологије)
                                </a>
                                <ul class="dropdown-menu" aria-labelledby="apiDropdown">
                                    <li>
                                        <a class="dropdown-item" asp-controller="TehnologijeAPI" asp-action="Index">
                                            Прикажи технологије
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="TehnologijeAPI" asp-action="Dodaj">
                                            Додај технологију
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Pocetna" asp-action="Privacy">Политика приватности</a>
                        </li>
                    </ul>

                    <ul class="navbar-nav">
                        @if (User.Identity?.IsAuthenticated ?? false)
                        {
                            
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="userDropdown"
                                   role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Здраво, @User.Identity.Name (@korisnikUloga)
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                                    <li>
                                        <a class="dropdown-item" asp-controller="Nalog" asp-action="Opcije">Подешавања</a>
                                    </li>
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <li>
                                            <a class="dropdown-item" asp-controller="Tehnologije" asp-action="Index">Управљање технологијама</a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="Kursevi" asp-action="Index">Управљање курсевима</a>
                                        </li>
                                    }
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <form asp-controller="Nalog" asp-action="OdjaviSe" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item text-danger">Одјава</button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Nalog" asp-action="Prijava">Пријава</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Nalog" asp-action="Registracija">Регистрација</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - Веб Курсеви - <a asp-area="" asp-controller="Pocetna" asp-action="Privacy">Политика приватности</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
